@startuml SDPTool Use Case Diagram
skinparam packageStyle rectangle
left to right direction

actor "Software Engineer" as SE
rectangle "SDPTool" {
  usecase "Pick Data Source" as UC_Data
  usecase "Tune Experiment" as UC_Configure
  usecase "Run & View Results" as UC_Run
  usecase "Monitor Progress" as UC_Monitor
  usecase "Manage Reports" as UC_Report
}

rectangle "GitHub API" as GH <<external>>
rectangle "Python ML Engine" as PY <<external>>

SE --> UC_Data : select project
SE --> UC_Configure : set options
SE --> UC_Run : launch & review
SE --> UC_Monitor : watch status
SE --> UC_Report : open latest

UC_Data ..> GH : fetch issues
UC_Run ..> PY : execute models\nproduce reports
UC_Report ..> PY : retrieve report

UC_Data --> UC_Configure
UC_Configure --> UC_Run
UC_Run --> UC_Monitor
UC_Run --> UC_Report

@enduml
