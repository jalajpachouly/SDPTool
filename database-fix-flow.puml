:initializeDatabaseSchema(conn);

:Check if ISSUE table exists?;
if (Table exists?) then (no)
  :Create all 14 tables:\n- ISSUE\n- LABEL\n- COMMENTS\n- CODE\n- PULL_RQ\n- etc.;
  note right
    Auto-initialization ✅
  end note
else (yes)
  :Schema already exists;
endif

:Connection returned;

:INSERT INTO ISSUE;
note right
  Tables exist ✅
  Insert succeeds ✅
end note

:Data saved successfully;

stop

